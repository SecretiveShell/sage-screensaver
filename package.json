{
  "name": "sage-screensaver",
  "version": "0.0.0",
  "description": "A reactive Three.js AI-agent animation for React.",
  "keywords": [
    "react",
    "threejs",
    "animation",
    "ai"
  ],
  "type": "module",
  "module": "./dist/lib/index.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/lib/index.js"
    }
  },
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist/lib",
    "dist/types"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm run build:app && pnpm run build:library",
    "build:app": "tsc && vite build",
    "build:library": "tsc -p tsconfig.library.json && vite build --config vite.library.config.ts",
    "prepack": "pnpm run build:library",
    "preview": "pnpm run build && wrangler dev",
    "deploy": "pnpm run build && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.47.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "three": "^0.185.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "wrangler": "^4.114.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "three": ">=0.185.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
